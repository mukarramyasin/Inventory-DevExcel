@model InventoryApp.Models.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Sku;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Product.Sku</li>
    </ol>
</nav>

<div class="app-card mb-4">
    <div class="app-card-body">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                    <h1 class="page-title mb-0">@Model.Product.Name</h1>
                    @if (!Model.Product.IsActive)
                    {
                        <span class="pill pill-muted pill-plain">Inactive</span>
                    }
                </div>

                <span class="sku-chip">@Model.Product.Sku</span>

                @if (!string.IsNullOrWhiteSpace(Model.Product.Description))
                {
                    <p class="page-subtitle mt-3 mb-3">@Model.Product.Description</p>
                }

                <dl class="detail-list mt-3">
                    <dt>Reorder level</dt>
                    <dd class="num">@Model.Product.ReorderLevel</dd>

                    <dt>Created (UTC)</dt>
                    <dd class="num">@Model.Product.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>

            <div class="col-lg-4 text-lg-end">
                <div class="kpi-label mb-1">Current stock</div>
                <div class="stock-hero mb-2">@Model.Product.CurrentStock</div>
                <partial name="_StatusBadge" model="Model.Product.Status" />

                <div class="mt-3 d-flex gap-2 justify-content-lg-end">
                    <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
                       asp-action="Edit" asp-route-id="@Model.Product.Id">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
                       asp-action="ExportMovements" asp-route-id="@Model.Product.Id">
                        <i class="bi bi-download"></i> Export CSV
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-4">
        <div class="app-card">
            <div class="app-card-header">Record a movement</div>
            <div class="app-card-body">
                @if (!Model.Product.IsActive)
                {
                    <p class="text-body-secondary mb-0">
                        This product is deactivated and cannot accept new movements. Reactivate it first.
                    </p>
                }
                else
                {
                    <partial name="_FormErrors" />

                    <form asp-action="RecordMovement" method="post">
                        <input type="hidden" asp-for="NewMovement.ProductId" />

                        <div class="mb-3">
                            <label class="form-label" asp-for="NewMovement.Type"></label>
                            <select class="form-select" asp-for="NewMovement.Type"
                                    asp-items="Html.GetEnumSelectList<MovementType>()"></select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" asp-for="NewMovement.Quantity"></label>
                            <input class="form-control" asp-for="NewMovement.Quantity" type="number" min="1" />
                            <span class="text-danger small" asp-validation-for="NewMovement.Quantity"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" asp-for="NewMovement.Note"></label>
                            <input class="form-control" asp-for="NewMovement.Note" placeholder="Optional reference" />
                            <span class="text-danger small" asp-validation-for="NewMovement.Note"></span>
                        </div>

                        <button class="btn btn-primary w-100" type="submit">Record movement</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="app-card">
            <div class="app-card-header">
                <span>Movement history</span>
                <span class="pill pill-muted pill-plain">@Model.Product.Movements.Count entries</span>
            </div>

            @if (Model.Product.Movements.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-clock-history"></i>
                    <p class="mb-0">No movements recorded yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table app-table">
                        <thead>
                            <tr>
                                <th scope="col">Date (UTC)</th>
                                <th scope="col">Type</th>
                                <th scope="col" class="text-end">Quantity</th>
                                <th scope="col">Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var movement in Model.Product.Movements)
                            {
                                <tr>
                                    <td class="text-nowrap num">@movement.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>
                                        @if (movement.Type == MovementType.In)
                                        {
                                            <span class="pill pill-success">IN</span>
                                        }
                                        else
                                        {
                                            <span class="pill pill-danger">OUT</span>
                                        }
                                    </td>
                                    <td class="text-end num fw-semibold">@movement.Quantity</td>
                                    <td class="text-body-secondary">@movement.Note</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
