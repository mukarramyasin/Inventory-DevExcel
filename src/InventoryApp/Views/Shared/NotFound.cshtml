@{
    ViewData["Title"] = "Not found";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="app-card">
            <div class="empty-state">
                <i class="bi bi-compass"></i>
                <h1 class="page-title mb-2">Not found</h1>
                <p class="page-subtitle mb-4">
                    That page or product does not exist. It may have been removed, or the address may be mistyped.
                </p>
                <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Back to products</a>
            </div>
        </div>
    </div>
</div>
